[Unit]
Description=Syn automatic restoration of ordinary password sudo
Documentation=https://github.com/ferrerluis/syn-approvals
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/var/lib/syn/recovery/synctl recover --restore-local-sudo --apply
Restart=on-failure
RestartSec=2s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
LockPersonality=yes
TimeoutStartSec=2min
