[Unit]
Description=Syn automatic restoration of ordinary password sudo
Documentation=https://github.com/ferrerluis/syn-approvals
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/var/lib/syn/recovery/synctl recover --restore-local-sudo --apply
Restart=on-failure
RestartSec=2s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
# Recovery must execute and validate the restored setuid sudo.ws provider.
# Ubuntu denies sudo.ws access to /etc/sudoers when it is launched with
# no_new_privs, even by this already-root, fixed-path recovery helper.
NoNewPrivileges=no
LockPersonality=yes
TimeoutStartSec=2min
